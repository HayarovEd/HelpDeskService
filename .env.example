# Database (Dev)
SPRING_DATASOURCE_URL_DEV=jdbc:postgresql://localhost:5432/helpdesk_dev
SPRING_DATASOURCE_USERNAME_DEV=postgres
SPRING_DATASOURCE_PASSWORD_DEV=postgres

# Database (Prod)
SPRING_DATASOURCE_URL_PROD=jdbc:postgresql://localhost:5432/helpdesk
SPRING_DATASOURCE_USERNAME_PROD=postgres
SPRING_DATASOURCE_PASSWORD_PROD=your_production_password

# Server
SERVER_PORT=9092

# Admin credentials
ADMIN_PASSWORD=your_admin_secure_password

# JWT
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_LENGTH=32
# JWT_PUBLIC_KEY_PATH=classpath:keys/public_key.pem
# JWT_PRIVATE_KEY_PATH=classpath:keys/private_key.pem

# CORS: разрешенные домены через запятую (для веб-виджетов, SPA и внешних порталов)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:9090,https://localhost:9090,http://localhost:9092,https://localhost:9092,https://helpdesk.impuls-perm.ru,http://helpdesk.impuls-perm.ru

# Huawei Push Kit (HMS)
HMS_APP_ID=
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
